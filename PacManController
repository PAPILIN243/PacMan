package edu.upb.lp.game.pacMan;

public class PacManGame {
	private int[][] mapa = new int[17][32];
	private PacMan Pacman;
	private PacManController controller;

	public PacManGame(PacManController controller) {
		this.Pacman = Pacman;
		this.controller = controller;
	}

	public void Mapa() {
		for (int f = 0; f < 1; f++) {
			for (int c = 0; c < 32; c++) {
				mapa[f][c] = 0;
			}
		}
		// 0 = pared; 1= camino vacio; 2= camino lleno
	}
	public void dibujarPacman(int filas, int columnas, int direccion) {
		controller.dibujarPacman(filas, columnas, direccion);
	}

	public void borrarPacman(int filas, int columnas) {
		controller.borrarPacman(filas, columnas);

	}

	public void moverIzquierda() {
		Pacman.MoverDerecha();
		
	}

	public void moverDerecha() {
Pacman.MoverIzquierda();		
	}
}
