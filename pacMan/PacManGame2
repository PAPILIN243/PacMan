	// 0 = pared; 1= camino vacio; 2= camino lleno

	public void dibujarPacman(int fila, int columna, int direccion) {
		if (mapa[fila][columna] == 2) {
			mapa[fila][columna] = 1;
			sumarScore(10);
			contadorDePuntos--;
			if (contadorDePuntos == 0) {
				victoria();
			}
		}
		boolean encontrada = false;
		Fruta frutaAComer = null;

		for (int i = 0; i < listaFrutas.size() && !encontrada; i++) {
			Fruta f = listaFrutas.get(i);
			if (f.getFila() == fila && f.getColumna() == columna) {
				frutaAComer = f;
				encontrada = true;
			}
		}

		if (frutaAComer != null) {
			recolectarFruta(frutaAComer);
		}
		controller.dibujarPacman(fila, columna, direccion);
		dibujarFrutas();
	}

