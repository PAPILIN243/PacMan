	public void start() {
		pacman.comenzarAAvanzar();
		dibujarFrutas(); // inicio dle juego
		inicializarFantasmas();
		dibujarVidasIniciales();
		executeRepeatedly(new Runnable() {
			@Override
			public void run() {
				actualizarAparicionFrutaPorTiempo();
			}
		}, 300);
	}

	public void dibujarFrutas() {
		for (int i = 0; i < listaFrutas.size(); i++) {
			Fruta f = listaFrutas.get(i);
			controller.dibujarFruta(f.getFila(), f.getColumna(), f.getNombre());
		}
	}

	public void dibujarVidasIniciales() {
		for (int i = 0; i < vidas; i++) {
			int f = casillasVidas[i][0];
			int c = casillasVidas[i][1];
			controller.dibujarVida(f, c);

		}
	}

	public void perderVida() {
		if (vidas > 0) {
			vidas--;
			int f = casillasVidas[vidas][0];
			int c = casillasVidas[vidas][1];
			controller.cambiarAVidaVacia(f, c);

		}
	}

	public void sumarScore(int puntos) {
		this.score += puntos;
		controller.actualizarPuntaje(this.score);
	}

	public void recolectarFruta(Fruta fruta) {
		controller.borrarPacman(fruta.getFila(), fruta.getColumna());
		listaFrutas.remove(fruta);
		// sumarPuntaje(100);
		fruta.aplicarPoder(this);

	}

	public void actualizarAparicionFrutaPorTiempo() {
		contadorTiempoFruta++;
		if (contadorTiempoFruta >= intervaloTiempoFruta) {
			contadorTiempoFruta = 0;
			if (listaFrutas.size() < maxFrutasSimultaneas) {
				generarFrutaAleatoria();
			}
		}
	}

	private void generarFrutaAleatoria() {
		LinkedList<Posicion> posicionesLibres = new LinkedList<>();
		for (int r = 0; r < filas; r++) {
			for (int c = 0; c < columnas; c++) {
				if (puedoIrAhi(r, c)) {
					posicionesLibres.add(new Posicion(r, c));
				}
			}
		}
		if (posicionesLibres.size() > 0) {
			int indice = random.nextInt(posicionesLibres.size());
			Posicion posElegida = posicionesLibres.get(indice);

			int f = posElegida.getFila();
			int c = posElegida.getColumna();

			int tipo = random.nextInt(4);
			Fruta nuevaFruta = null;

			if (tipo == 0) {
				nuevaFruta = new Cereza(f, c);
			} else if (tipo == 1) {
				nuevaFruta = new Pina(f, c);
			} else if (tipo == 2) {
				nuevaFruta = new Manzana(f, c);
			} else if (tipo == 3) {
				nuevaFruta = new Uva(f, c);
			}

			listaFrutas.add(nuevaFruta);

			if (controller != null) {
				controller.dibujarFruta(f, c, nuevaFruta.getNombre().toLowerCase());
			}
		}
	}

	private void inicializarFrutas() {
		generarFrutaAleatoria();
	}

