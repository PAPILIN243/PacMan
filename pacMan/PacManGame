		public void verificarColision() {
		    for (int i = 0; i < arrFant.length; i++) {
		        if (arrFant[i] != null) {
		            int ff = arrFant[i].getFilas();
		            int fc = arrFant[i].getColumnas();        
		            
		            if (pacman.getFila() == ff && pacman.getColumna() == fc) {
		                // 1. Detenemos el movimiento de Pacman y fantasmas inmediatamente
		                pacman.detenerse();
		                for (int j = 0; j < arrFant.length; j++) {
		                    if (arrFant[j] != null) {
		                        arrFant[j].dejarDeAvanzar();
		                    }
		                }
		                perderVida(); 
		              
		                if (vidas > 0) {
		                    controller.executeLater(new Runnable() {
		                        @Override
		                        public void run() {
		                            start(); 
		                        }
		                    }, 3000);
		                } else {
		                
//		                    controller.playSound("game_over"); 
		                }
		                
		                break; 
		            }
		        }
		    }
		}
	
	public void reiniciarPosiciones() {
		pacman.detenerse();
	    controller.borrarPacman(pacman.getFila(), pacman.getColumna());
	    for (int i = 0; i < arrFant.length; i++) {
	        if (arrFant[i] != null) {
	            arrFant[i].dejarDeAvanzar();
	            controller.borrarFantasma(arrFant[i].getFilas(), arrFant[i].getColumnas());
	        }
	    }
	}
