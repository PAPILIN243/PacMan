	private PacMan pacman;
	private PacManController controller;
	

	private List<Fruta> listaFrutas;
	private List<Fruta> frutasRecolectadas;

	public PacManGame(PacManController controller) {
        this.controller = controller; 
        this.pacman = new PacMan(10, 15, this);
        this.listaFrutas = new ArrayList<>();
        this.frutasRecolectadas = new ArrayList<>();
        
        inicializarFrutas();
    }

	public void dibujarPacman(int filas, int columnas, int direccion) {
		controller.dibujarPacman(filas, columnas, direccion);
	}

	public void borrarPacman(int filas, int columnas) {
		controller.borrarPacman(filas, columnas);
	}

	public void girarArriba() {
		pacman.girarArriba();
	}

	public void girarAbajo() {
		pacman.girarAbajo();
	}

	public void girarDerecha() {
		pacman.girarDerecha();
	}

	public void girarIzquierda() {
		pacman.girarIzquierda();
	}

	public void moverPacman() {
		pacman.avanzarPacman();
	}

	public boolean puedoIrAhi(int v, int h) {
		return mapa[v][h] > 0;
	}

	public void executeRepeatedly(Runnable r, int ms) {
		controller.executeRepeatedly(r, ms);
	}

	public void start() {
		pacman.comenzarAAvanzar();
		dibujarFrutas(); //inicio dle juego
	}

	public void dibujarFrutas() {
	    for (int i = 0; i < listaFrutas.size(); i++) {
	        Fruta f = listaFrutas.get(i);
	        controller.dibujarFruta(f.getFila(), f.getColumna(), f.getNombre());
	    }
	}

	public void recolectarFruta(Fruta fruta) {
        listaFrutas.remove(fruta);              
        frutasRecolectadas.add(fruta);          
        controller.borrarPacman(fruta.getFila(), fruta.getColumna()); 
        fruta.aplicarPoder(this);                
    }

	public List<Fruta> getListaFrutas() {
        return listaFrutas;
    }

	public List<Fruta> getFrutasRecolectadas() {
		return frutasRecolectadas;
	}

	public int getFilas() {
		return filas;
	}

	public int getColumnas() {
		return columnas;
	}

	private void inicializarFrutas() {
		listaFrutas.add(new Cereza(1, 1));
        listaFrutas.add(new Piña(4, 5));
        listaFrutas.add(new Manzana(8, 12));
        listaFrutas.add(new Uva(10, 18));
    }
}
