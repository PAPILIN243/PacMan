	private PacMan pacman;
	private Fantasma fantasma;
	private PacManController controller;
	private int score = 0;
	private List<Fruta> listaFrutas;
	private Fantasma[] listaFant = new Fantasma[4];

	public PacManGame(PacManController controller) {
		this.controller = controller;
		this.pacman = new PacMan(10, 15, this);

		this.listaFrutas = new LinkedList<>();
		inicializarFrutas();
	}

	// 0 = pared; 1= camino vacio; 2= camino lleno

	public void dibujarPacman(int fila, int columna, int direccion) {
		if (mapa[fila][columna] == 2) {
			mapa[fila][columna] = 1;
			score++;
			if (score == 1000) {
				pacman.detenerse();
				controller.dibujarFruta(0, 0, "bugs_happy_bug");
			}
		}
		controller.dibujarPacman(fila, columna, direccion);
	}
	//

	public void borrarPacman(int fila, int columna) {
		controller.borrarPacman(fila, columna);
	}

	public void girarArriba() {
		pacman.girarArriba();
	}

	public void girarAbajo() {
		pacman.girarAbajo();
	}

	public void girarDerecha() {
		pacman.girarDerecha();
	}

	public void girarIzquierda() {
		pacman.girarIzquierda();
	}

	public void moverPacman() {
		pacman.avanzarPacman();
	}

	public boolean puedoIrAhi(int v, int h) {
		return mapa[v][h] > 0;
	}

	public String executeRepeatedly(Runnable r, int ms) {
		return controller.executeRepeatedly(r, ms);
	}

	public void start() {
		pacman.comenzarAAvanzar();
		dibujarFrutas();
		inicializarFantasmas();
	}

	public void dibujarFrutas() {
		for (int i = 0; i < listaFrutas.size(); i++) {
			Fruta f = listaFrutas.get(i);
			controller.dibujarFruta(f.getFila(), f.getColumna(), f.getNombre());
		}
	}

	public int getValor(int fila, int columna) {
		return this.mapa[fila][columna];
	}

	public void setValor(int fila, int columna, int valor) {
		this.mapa[fila][columna] = valor;
	}

	public boolean hayPunto(int r, int c) {
		return mapa[r][c] == 2;
	}

	public void stopLoop(String id) {
		controller.stopLoop(id);
	}

	public List<Fruta> getListaFrutas() {
		return listaFrutas;
	}

	private void inicializarFrutas() {
		listaFrutas.add(new Cereza(1, 1));
		listaFrutas.add(new Pina(4, 5));
		listaFrutas.add(new Manzana(8, 12));
		listaFrutas.add(new Uva(10, 18));
	}

	private void inicializarFantasmas() {
		for (int i = 0; i < 4; i++) {
			listaFant[i]=new Fantasma(8, 15+i, 0, i,this);	
			listaFant[i].dibujar();
			listaFant[i].comenzarMovimiento();
		}
	}

	public void borrarFantasma(int fila, int columna) {
		controller.borrarFantasma(fila,columna);
		
	}

	public void dibujarFantasma(int fila, int columna, String imagen) {
		controller.dibujarFantasma(fila, columna, imagen);
		
	}
