	private void generarFrutaAleatoria() {
		int f = random.nextInt(filas);
	    int c = random.nextInt(columnas);

	    boolean posicionInvalida = !puedoIrAhi(f, c);
	    while (posicionInvalida) {
	        f = random.nextInt(filas);
	        c = random.nextInt(columnas);
	        posicionInvalida = !puedoIrAhi(f, c);
	    }

	    //  0 cereza 1 pina 2 manzana 3 uva
	    int tipo = random.nextInt(4);
	    Fruta nuevaFruta = null;

	    if (tipo == 0) {
	        nuevaFruta = new Cereza(f, c);
	    } else if (tipo == 1) {
	        nuevaFruta = new Pina(f, c);
	    } else if (tipo == 2) {
	        nuevaFruta = new Manzana(f, c);
	    } else if (tipo == 3) {
	        nuevaFruta = new Uva(f, c);
	    }

	    listaFrutas.add(nuevaFruta);
	    controller.dibujarFruta(f, c, nuevaFruta.getNombre().toLowerCase()); 
	   
	}

	private void inicializarFrutas() {
		for (int i = 0; i < 9; i++) { // 8 fruta aparece al iniciar
			generarFrutaAleatoria();
		}
	}
	
	private void inicializarFantasmas() {
		for (int i = 0; i < 4; i++) {
			arrFant[i]=new Fantasma(8, 14+i, 0, i,this);	
			arrFant[i].dibujar();
			arrFant[i].comenzarMovimiento();
		}
	}
