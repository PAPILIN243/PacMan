public class PacManController implements GameController {
	private GameUI libreria;
	private PacManGame game;

	public PacManController(GameUI libreria) {
		this.libreria = libreria;
		this.game = new PacManGame(this);
	}

	@Override
	public void onButtonPressed(String name) {
		// TODO Auto-generated method stub

	}

	@Override
	public void onCellPressed(int row, int col) {
		// TODO Auto-generated method stub

	}

	@Override
	public void onCommand(String command) {
//			if (command.equals("MoverArriba")) {
//				game.moverArriba();
//			} else if (command.equals("MoverAbajo")) {
//				game.moverAbajo();
//			} else
		if (command.equals("MoverIzquierda")) {
			game.moverIzquierda();
		} else if (command.equals("MoverDerecha")) {
			game.moverDerecha();
		}
	}
	

	@Override
	public void initialiseInterface() {
		libreria.configureGrid(18, 32, 1200, 600, false);
		libreria.setCellObjectImage(10, 15, "pacman_arriba");
		for (int r = 0; r < 18; r++) {
			for (int c = 0; c < 32; c++) {
				String nombreImagen = "Mapa_r" + (r + 1) + "_c" + (c + 1);
				libreria.setCellBackgroundImage(r, c, nombreImagen);

			}
		}
//	libreria.addButton("Reiniciar");// posible reinicio en un futuro
		libreria.bindKey("W", "MoverArriba");
		libreria.bindKey("S", "MoverAbajo");
		libreria.bindKey("A", "MoverIzquierda");
		libreria.bindKey("D", "MoverDerecha");
	}


	public void dibujarPacman(int filas, int columnas, int direccion) {
		String Pacmanimg = "pacman_arriba";
		if (direccion == 0) {
			Pacmanimg = "pacman_arriba";
		} else if (direccion == 1) {
			Pacmanimg = "pacman_derecha";
		} else if (direccion == 2) {
			Pacmanimg = "pacman_abajo";
		} else if (direccion == 3) {
			Pacmanimg = "pacman_izquierda";
		}
		libreria.setCellObjectImage(filas, columnas, Pacmanimg);

	}

	public void borrarPacman(int filas, int columnas) {
		
		libreria.clearCellObjectImage(filas, columnas);

	}}
