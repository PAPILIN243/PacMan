package edu.upb.lp.game.pacMan;

public class Pina extends Fruta{

	public Pina(int fila, int columna) {
		super("Pina", fila, columna);
		// TODO Auto-generated constructor stub
	}

	@Override
	public void aplicarPoder(PacManGame game) {
		game.activarVelocidadTemporal(5000);
		game.showTemporaryMessage("Velocidad aumentada!");
	}

}
