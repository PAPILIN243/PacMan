package edu.upb.lp.game.pacMan;

public abstract class Fruta {
    private String nombre;
    private int fila;
    private int columna;

    public Fruta(String nombre, int fila, int columna) {
        this.nombre = nombre;
        this.fila = fila;
        this.columna = columna;
    }

    public String getNombre() {
        return nombre;
    }

    public int getFila() {
        return fila;
    }

    public int getColumna() {
        return columna;
    }

    public abstract void aplicarPoder(PacManGame game);
}
